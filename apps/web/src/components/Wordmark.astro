---
interface Props {
  href?: string;
  compact?: boolean;
}

const { href = '/', compact = false } = Astro.props;
---

<a class:list={['wordmark', { 'wordmark--compact': compact }]} href={href}>
  <span class="wordmark__mark" aria-hidden="true">
    V/
  </span>
  <span class="wordmark__name">Vinny Codes</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    width: fit-content;
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--border-thin) solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-action-muted);
    font-size: var(--font-size-caption);
    letter-spacing: -0.08em;
  }

  .wordmark--compact .wordmark__name {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
