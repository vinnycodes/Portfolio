---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'small' | 'medium' | 'large';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'medium',
  class: className,
  target,
  rel,
  ...attributes
} = Astro.props;

const safeRel = target === '_blank' ? (rel ?? 'noreferrer') : rel;
---

<a
  {...attributes}
  href={href}
  target={target}
  rel={safeRel}
  class:list={[
    'action-control',
    `action-control--${variant}`,
    `action-control--${size}`,
    className,
  ]}
>
  <slot />
</a>
