---
export interface TokenItem {
  label: string;
  token: `--${string}`;
}

interface Props {
  title: string;
  description: string;
  kind?: 'color' | 'space' | 'radius' | 'shadow' | 'value';
  items: TokenItem[];
}

const { title, description, kind = 'value', items } = Astro.props;
---

<section class="token-table" data-token-table data-kind={kind}>
  <header>
    <p class="token-table__eyebrow">Foundation</p>
    <h2>{title}</h2>
    <p class="token-table__description">{description}</p>
  </header>

  <ul>
    {items.map(({ label, token }) => (
      <li>
        <span
          class="token-table__preview"
          style={`--token-preview: var(${token})`}
          aria-hidden="true"
        />
        <span class="token-table__identity">
          <strong>{label}</strong>
          <code>{token}</code>
        </span>
        <code class="token-table__value" data-token-value={token}>
          {token}
        </code>
      </li>
    ))}
  </ul>
</section>

<script is:inline>
  (() => {
    const updateTokenValues = () => {
      document.querySelectorAll('[data-token-table]').forEach((table) => {
        const kind = table.getAttribute('data-kind');
        const rootStyles = getComputedStyle(document.documentElement);

        table.querySelectorAll('[data-token-value]').forEach((value) => {
          const token = value.getAttribute('data-token-value');
          if (!token) return;

          if (kind === 'color') {
            const probe = document.createElement('span');
            probe.style.color = `var(${token})`;
            document.body.append(probe);
            value.textContent = getComputedStyle(probe).color;
            probe.remove();
            return;
          }

          value.textContent = rootStyles.getPropertyValue(token).trim();
        });
      });
    };

    updateTokenValues();

    const observerMarker = 'data-token-table-observer';
    if (!document.documentElement.hasAttribute(observerMarker)) {
      document.documentElement.setAttribute(observerMarker, '');
      new MutationObserver(updateTokenValues).observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: ['data-theme'],
        }
      );
    }
  })();
</script>

<style>
  .token-table {
    width: min(100%, 64rem);
    padding: clamp(var(--space-5), 4vw, var(--space-10));
    color: var(--color-text);
  }

  .token-table > header {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }

  .token-table__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .token-table > header > h2 {
    font-size: var(--font-size-heading-md);
    letter-spacing: var(--tracking-tight);
    line-height: var(--line-height-heading);
  }

  .token-table__description {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .token-table > ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .token-table > ul > li {
    display: grid;
    grid-template-columns: 3rem minmax(10rem, 1fr) minmax(8rem, auto);
    gap: var(--space-4);
    align-items: center;
    min-height: 4.5rem;
    padding: var(--space-3) var(--space-4);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .token-table__preview {
    display: block;
    width: 3rem;
    height: 3rem;
    border: var(--border-thin) solid var(--color-border-strong);
    background: var(--token-preview);
  }

  .token-table[data-kind='color'] .token-table__preview {
    border-radius: 50%;
  }

  .token-table[data-kind='space'] .token-table__preview {
    width: min(var(--token-preview), 3rem);
    height: min(var(--token-preview), 3rem);
    min-width: 0.25rem;
    min-height: 0.25rem;
    border: 0;
    background: var(--color-focus);
  }

  .token-table[data-kind='radius'] .token-table__preview {
    border-radius: var(--token-preview);
    background: var(--color-action-muted-hover);
  }

  .token-table[data-kind='shadow'] .token-table__preview {
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-surface-solid);
    box-shadow: var(--token-preview);
  }

  .token-table__identity {
    display: grid;
    gap: var(--space-1);
    min-width: 0;
  }

  .token-table__identity > strong {
    font-size: var(--font-size-label);
  }

  .token-table code {
    color: var(--color-text-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.75rem;
  }

  .token-table__value {
    min-width: 0;
    text-align: right;
    overflow-wrap: anywhere;
  }

  @media (max-width: 39.99rem) {
    .token-table > ul > li {
      grid-template-columns: 3rem 1fr;
    }

    .token-table__value {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
