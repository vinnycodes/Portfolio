{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "portfolio site",
  "main": "index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sass": "sass --watch src/scss/main.scss:dist/css/main.css",
    "dev": "webpack --mode development",
    "build:styles": "sass src/scss/main.scss dist/css/main.css --no-source-map",
    "build": "npm run build:styles && webpack --mode production",
    "start": "webpack serve --mode development --open",
    "start-sass": "concurrently \"npm:sass\" \"npm:start\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/core": "^7.11.6",
    "@babel/polyfill": "^7.11.5",
    "babel-loader": "^8.1.0",
    "babel-preset-env": "^1.7.0",
    "gsap": "^3.5.1",
    "html-webpack-plugin": "^5.6.8",
    "scrollmagic": "^2.0.7",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "sass": "^1.105.0"
  }
}
