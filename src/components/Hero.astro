---
import BentoCard from './BentoCard.astro';
import SquigglyLine from './SquigglyLine.astro';
---

<div class="pb-12">
  <BentoCard padding="lg" class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-gray-900 mb-2">
        VinnyCodes <span class="inline-block text-gray-400 ml-12">here's to creating...</span>
      </h1>
      <!-- Animated squiggly line -->
      <SquigglyLine class="mt-10" />
    </div>

    <div class="space-y-6 text-gray-600 leading-relaxed">
      <p>I create.</p>

      <p>Online experiences using code.</p>

      <p>A touch of design.</p>

      <p>The family penne alla vodka recipe.</p>

      <p>A thought provoking substack.</p>

      <p>Because creation is one of the greatest parts of being human.</p>

      <p>Ex Nihilo*.<br />Copied or Stolen. Good or Great Artist.</p>

      <p>Let's create</p>

      <p class="text-sm text-gray-400 italic">* Latin for "out of nothing."</p>
    </div>
  </BentoCard>
</div>
