---
import BentoCard from './BentoCard.astro';
---

<div class="pb-12">
  <BentoCard padding="lg" class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-gray-900 mb-2">
        Vinny <span class="text-gray-400">is creating something new...</span>
      </h1>
      <!-- Animated squiggly line -->
      <div class="relative w-48 h-3 mb-4">
        <svg
          class="w-full h-full"
          viewBox="0 0 200 12"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M2 6 Q25 2, 50 6 T100 6 Q125 10, 150 6 T198 6"
            stroke="#ef4444"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
            class="crayon-line"
            pathLength="1"></path>
        </svg>
      </div>
    </div>

    <div class="space-y-6 text-gray-600 leading-relaxed">
      <p>I create.</p>

      <p>Online experiences using code.</p>

      <p>A touch of design.</p>

      <p>The family penne alla vodka recipe.</p>

      <p>A thought provoking substack.</p>

      <p>I believe creation is one of the greatest parts of being human.</p>

      <p>Ex Nihilo*.<br />Copied or Stolen. Good or Great Artist.</p>

      <p>Let's create</p>

      <p class="text-sm text-gray-400 italic">* Latin for "out of nothing."</p>
    </div>
  </BentoCard>
</div>
