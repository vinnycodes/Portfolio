---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import BentoCard from '../components/BentoCard.astro';
---

<Layout title="About - Vinny Codes">
  <Navigation />
  <main class="min-h-screen bg-white">
    <div class="max-w-4xl mx-auto px-6 py-24">
      <BentoCard padding="lg" class="space-y-8">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-4">About Me</h1>
          <p class="text-xl text-gray-600">Getting to know Vinny</p>
        </div>
        
        <div class="space-y-6 text-gray-600 leading-relaxed">
          <p>This is the about page. More content coming soon...</p>
          
          <p>I'm passionate about creating digital experiences that matter.</p>
          
          <p>Currently working on building beautiful, functional websites and applications.</p>
        </div>
      </BentoCard>
    </div>
  </main>
</Layout>