---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import BentoGrid from '../components/BentoGrid.astro';
---

<Layout title="Vinny Codes - Portfolio">
  <Navigation />
  <main class="min-h-screen bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex justify-end pt-24 mb-2 pr-3">
		<!-- Click SVG ICON -->
        <div class="flex items-center gap-2 text-gray-500 click-icon-container">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path class="radiating-line" d="M3 12l3 0" />
            <path class="radiating-line" d="M12 3l0 3" />
            <path class="radiating-line" d="M7.8 7.8l-2.2 -2.2" />
            <path class="radiating-line" d="M16.2 7.8l2.2 -2.2" />
            <path class="radiating-line" d="M7.8 16.2l-2.2 2.2" />
            <path class="click-arrow" d="M12 12l9 3l-4 2l-2 4l-3 -9" />
          </svg>
          <span class="text-sm cursor-default">Look around...</span>
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
        <Hero />
        <BentoGrid />
      </div>
    </div>
  </main>
</Layout>
