---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import BentoCard from '../components/BentoCard.astro';
---

<Layout title="Work - Vinny Codes">
  <Navigation />
  <main class="min-h-screen bg-white">
    <div class="max-w-6xl mx-auto px-6 py-24">
      <div class="mb-12">
        <BentoCard padding="lg" class="text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">My Work</h1>
          <p class="text-xl text-gray-600">
            A collection of projects and experiences
          </p>
        </BentoCard>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <BentoCard padding="md">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Project One</h3>
          <p class="text-sm text-gray-600 mb-4">
            Description of project one coming soon...
          </p>
          <div class="text-xs text-gray-400">React • TypeScript • Tailwind</div>
        </BentoCard>

        <BentoCard padding="md">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Project Two</h3>
          <p class="text-sm text-gray-600 mb-4">
            Description of project two coming soon...
          </p>
          <div class="text-xs text-gray-400">Astro • SCSS • Framer Motion</div>
        </BentoCard>

        <BentoCard padding="md">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
            Project Three
          </h3>
          <p class="text-sm text-gray-600 mb-4">
            Description of project three coming soon...
          </p>
          <div class="text-xs text-gray-400">Next.js • Sanity • Vercel</div>
        </BentoCard>
      </div>
    </div>
  </main>
</Layout>
